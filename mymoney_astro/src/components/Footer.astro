---
const currentYear = new Date().getFullYear();

const footerLinks = [
  { href: '#features', label: 'Features' },
  { href: '/terms-of-use', label: 'Terms of Use' },
  { href: '/privacy-policy', label: 'Privacy Policy' },
];
---

<footer class="footer">
  <div class="container">
    <div class="footer-content">
      <div class="footer-brand">
        <a href="/" class="logo">
          <img
            src="/images/QCXQ1Bx4xiXuFmpYqLrfkr2Np8I.png"
            alt="Rotina Logo"
            width="48"
            height="48"
          />
          <div class="logo-info">
            <span class="logo-text">Habit Tracker - Rotina</span>
            <span class="tagline">Empower Your Habit Journey with Rotina</span>
          </div>
        </a>
      </div>

      <div class="footer-links">
        <nav>
          <ul class="links-list">
            {footerLinks.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      </div>

      <div class="footer-contact">
        <a href="mailto:support@habitrotina.com" class="email-link">
          support@habitrotina.com
        </a>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {currentYear} Rotina. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-16);
    margin-top: auto;
  }

  .footer-content {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: var(--space-8);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--color-border);
  }

  .footer-brand .logo {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    text-decoration: none;
  }

  .footer-brand img {
    border-radius: var(--radius-lg);
  }

  .logo-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .logo-text {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .tagline {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .links-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .links-list a {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .links-list a:hover {
    color: var(--color-text-primary);
  }

  .email-link {
    font-size: var(--text-sm);
    color: var(--color-accent);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .email-link:hover {
    color: var(--color-accent-light);
  }

  .footer-bottom {
    padding-top: var(--space-6);
    text-align: center;
  }

  .footer-bottom p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .footer-content {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .footer-brand .logo {
      justify-content: center;
    }

    .links-list {
      align-items: center;
    }
  }
</style>
