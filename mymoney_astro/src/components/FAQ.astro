---
// FAQ section component

const faqs = [
  {
    question: 'Is Rotina free to use?',
    answer: 'Yes! Rotina offers a free plan that allows you to track up to 5 habits with basic features. For unlimited habits and advanced features like routine mode and widgets, you can upgrade to Pro.'
  },
  {
    question: 'Does Rotina require an account?',
    answer: 'No account is required! Rotina values your privacy - all your data stays on your device. No login, no sign-up, just start building habits immediately.'
  },
  {
    question: 'Can I backup my habits?',
    answer: 'Yes! With the Pro plan, you can export all your habits and data. Save it to your preferred cloud storage or device and restore it anytime you need.'
  },
  {
    question: 'What platforms is Rotina available on?',
    answer: 'Rotina is available on iOS and Android devices. Both versions offer the same great features and sync seamlessly if you use the export/import feature.'
  },
  {
    question: 'How do the smart reminders work?',
    answer: 'In Routine Mode, you can set a duration for each habit. You\'ll receive three reminders: one before the activity starts, one at the start time, and one when it\'s time to finish and move on.'
  },
  {
    question: 'Can I share my progress on social media?',
    answer: 'Absolutely! Rotina creates beautiful visual cards of your progress that you can share directly to social media. Celebrate your wins and inspire others!'
  }
];
---

<section id="faq" class="faq section">
  <div class="container">
    <div class="section-header text-center">
      <h2>Frequently Asked Questions</h2>
      <p>Everything you need to know about Rotina.</p>
    </div>

    <div class="faq-list">
      {faqs.map((faq, index) => (
        <details class="faq-item">
          <summary class="faq-question">
            <span>{faq.question}</span>
            <svg class="faq-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 5v14M5 12h14"/>
            </svg>
          </summary>
          <div class="faq-answer">
            <p>{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    background: var(--color-surface);
  }

  .section-header {
    margin-bottom: var(--space-12);
  }

  .section-header h2 {
    margin-bottom: var(--space-4);
  }

  .section-header p {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    margin-inline: auto;
  }

  .faq-list {
    max-width: 800px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .faq-item {
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: border-color var(--transition-base);
  }

  .faq-item:hover {
    border-color: var(--color-accent);
  }

  .faq-item[open] {
    border-color: var(--color-accent);
  }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-5) var(--space-6);
    cursor: pointer;
    font-weight: 600;
    color: var(--color-text-primary);
    list-style: none;
    transition: background var(--transition-base);
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question:hover {
    background: var(--color-surface-elevated);
  }

  .faq-icon {
    flex-shrink: 0;
    color: var(--color-text-muted);
    transition: transform var(--transition-base);
  }

  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    color: var(--color-accent);
  }

  .faq-answer {
    padding: 0 var(--space-6) var(--space-6);
  }

  .faq-answer p {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0;
  }
</style>
